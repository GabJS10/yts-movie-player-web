---
// One row per installer; the visitor's OS row is highlighted client-side (scripts/os.ts).
import Icon from './Icon.astro';
import type { Release, PlatformKey } from '../lib/release';
import { pageLang } from '../i18n';

interface Props { release: Release }
const { release } = Astro.props;
const { ui } = pageLang(Astro.url);

const BUTTON: Record<PlatformKey, string> = { win: '.exe', deb: '.deb', rpm: '.rpm', appimage: 'AppImage' };
const PLATFORMS = (Object.keys(BUTTON) as PlatformKey[]).map((key) => ({ key, ...ui.platforms[key], button: BUTTON[key] }));
---
<div class="dlt">
  {PLATFORMS.map((p) => (
    <div class="dlt-row" data-os={p.key}>
      <span class="radio" aria-hidden="true"></span>
      <div class="dlt-os"><b>{p.title}</b><span>{p.note}</span><span class="here">{ui.yourSystem}</span></div>
      <div class="dlt-file">{release.assets[p.key].name ? <code>{release.assets[p.key].name}</code> : <span class="dlt-gh">{ui.onGitHub}</span>}</div>
      <a class="btn btn-line btn-sm" href={release.assets[p.key].url}><Icon name="dl" />{p.button}</a>
    </div>
  ))}
</div>
