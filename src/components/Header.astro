---
import Icon from './Icon.astro';
import { REPO_URL } from '../lib/release';
import { pageLang, alternatesOf, ROUTES } from '../i18n';

const { lang, path, ui } = pageLang(Astro.url);
const r = (key: keyof typeof ROUTES) => ROUTES[key][lang];
const docsRoot = lang === 'es' ? '/docs' : '/en/docs';
const current = (prefix: string) => (path === prefix || path.startsWith(`${prefix}/`) ? 'page' : undefined);
// The same page in the other language (its home for pages without a pair, like the 404).
const other = lang === 'es' ? 'en' : 'es';
const otherHref = (alternatesOf(path) ?? ROUTES.home)[other];
---
<header class="top" id="top">
  <a class="brand" href={r('home')}>
    <img src="/app-icon.svg" alt="" width="30" height="30" /><b>YTS</b><span>Player</span>
  </a>
  <nav class="nav" aria-label={ui.navLabel}>
    <a href={r('download')} aria-current={current(r('download'))}>{ui.download}</a>
    <a href={r('subtitles')} aria-current={current(docsRoot)}>{ui.docs}</a>
    <a href={r('changelog')} aria-current={current(r('changelog'))}>{ui.changelog}</a>
    <a href={REPO_URL}>GitHub</a>
  </nav>
  <div class="top-end">
    <a class="lang" href={otherHref} hreflang={other} lang={other} data-lang-pick={other} title={ui.switchTo.title}>
      <Icon name="globe" /><span class="lang-long">{ui.switchTo.label}</span><span class="lang-short" aria-hidden="true">{ui.switchTo.short}</span>
    </a>
    <a class="btn btn-line btn-sm" href={r('download')} aria-label={ui.download}><Icon name="dl" /><span>{ui.download}</span></a>
  </div>
</header>
