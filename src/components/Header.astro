---
import Icon from './Icon.astro';
import { REPO_URL } from '../lib/release';
import { cleanPath } from '../lib/url';

const path = cleanPath(Astro.url.pathname);
const current = (prefix: string) => (path === prefix || path.startsWith(`${prefix}/`) ? 'page' : undefined);
---
<header class="top" id="top">
  <a class="brand" href="/">
    <img src="/app-icon.svg" alt="" width="30" height="30" /><b>YTS</b><span>Player</span>
  </a>
  <nav class="nav" aria-label="Principal">
    <a href="/descargar" aria-current={current('/descargar')}>Descargar</a>
    <a href="/docs/subtitulos" aria-current={current('/docs')}>Documentación</a>
    <a href="/novedades" aria-current={current('/novedades')}>Novedades</a>
    <a href={REPO_URL}>GitHub</a>
  </nav>
  <a class="btn btn-line btn-sm" href="/descargar" aria-label="Descargar"><Icon name="dl" /><span>Descargar</span></a>
</header>
