---
import '../styles/global.css';
import fontLatin from '../assets/fonts/archivo-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import { pageLang, alternatesOf, LANGS, LOCALE, ROUTES } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Pages that must stay out of search results (the 404). */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const { lang, path, ui } = pageLang(Astro.url);
const canonical = new URL(path, Astro.site);
const og = new URL('/og.png', Astro.site);
const alternates = noindex ? null : alternatesOf(path);
const ogLocale = (l: string) => LOCALE[l as keyof typeof LOCALE].replace('-', '_');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {path === ROUTES.home.es && (
      // First visit to the root from outside the site: English unless the browser prefers Spanish.
      // An explicit pick in the language switcher (localStorage) always wins; arriving from another
      // page of the site never redirects, and neither do crawlers (the Spanish home must stay indexable).
      <script is:inline>
        try {
          var ref = document.referrer && new URL(document.referrer).origin === location.origin;
          var pick = localStorage.getItem('lang');
          var bot = /bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent);
          var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
          if (!ref && !bot && pick !== 'es' && (pick === 'en' || first.slice(0, 2) !== 'es')) location.replace('/en' + location.search + (location.hash === '#descargas' ? '#downloads' : location.hash));
        } catch (e) {}
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
    <meta name="theme-color" content="#171717" />
    <link rel="icon" href="/app-icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale(lang === 'es' ? 'en' : 'es')} />}
    <meta property="og:site_name" content="YTS Player" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={ui.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <Icons />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
