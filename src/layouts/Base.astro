---
import '../styles/global.css';
import fontLatin from '../assets/fonts/archivo-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import { cleanPath } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Pages that must stay out of search results (the 404). */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const og = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#171717" />
    <link rel="icon" href="/app-icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="YTS Player" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content="Inicio de YTS Player con una película destacada y la fila Tendencias." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <Icons />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
