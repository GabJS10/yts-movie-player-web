---
// Reading pages (install, docs, changelog, legal): a section nav beside one readable column.
import Base from './Base.astro';
import '../styles/doc.css';
import { pageLang, ROUTES } from '../i18n';

interface Props {
  title: string;
  /** Page heading; defaults to the title. */
  heading?: string;
  description: string;
  lede?: string;
}
const { title, heading = title, description, lede } = Astro.props;
const { lang, path, ui } = pageLang(Astro.url);

const nav = (Object.keys(ui.docLinks) as (keyof typeof ui.docLinks)[]).map((key) => ({
  href: ROUTES[key][lang],
  label: ui.docLinks[key],
}));
---
<Base title={`${title} · YTS Player`} description={description}>
  <div class="doc wrap">
    <nav class="doc-nav" aria-label={ui.docNav}>
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <article class="doc-main">
      <header class="doc-head">
        <h1 class="headline">{heading}</h1>
        {lede && <p class="lead">{lede}</p>}
        <slot name="head" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
  <script>import '../scripts/copy';</script>
</Base>
