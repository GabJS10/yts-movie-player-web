---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · YTS Player" description="Esta página no existe." noindex>
  <section class="wrap" style="padding-block: 160px 120px; display: grid; gap: 22px; justify-items: start;">
    <p class="display">404</p>
    <h1 class="headline">Esta página no existe</h1>
    <p class="lead">Puede que el enlace esté mal o que la página se haya movido.</p>
    <div style="display:flex; flex-wrap:wrap; gap:12px;">
      <a class="btn btn-play" href="/">Ir al inicio</a>
      <a class="btn btn-line" href="/descargar">Descargar</a>
    </div>
  </section>
</Base>
